import com.nolimitscoaster.*;

class MineralForgeCoasterScript extends Script {

    // region Definitions
    
    // region Define Objects

    // region Define Coaster
    Coaster coaster;
    // endregion

    // region Define Station Sections
    Section loadingStation;
    // endregion

    // region Define Block Sections
    Section furnaceBlock;
    Section monsterBlock;
    Section monsterApproachBlock;
    // endregion

    // region Define Transport Sections
    Section mineEntranceTransport;
    Section furnaceApproach;
    Section liftLaunch;
    // endregion

    // region Define Special Tracks
    SpecialTrack furnaceTransfer;
    SpecialTrack monsterTransfer;
    // endregion

    // endregion

    // region Define Constants
    final int DEFAULT_FURNACE_TRANSFER_POSITION = 0;
    final int DEFAULT_MONSTER_TRANSFER_POSITION = 0;

    final int IDLE_PHASE = 0;
    final int APPROACH_PHASE = 1;
    final int PRE_SHIFT_PHASE = 2;
    final int SHIFT_PHASE = 3;
    final int POST_SHIFT_PHASE = 4;
    final int LAUNCHING_PHASE = 5;
    final int RESET_PHASE = 6;
    // endregion

    // region Define Variables

    // region Counters
    float basicCounter;
    float mineEntranceCounter;
    float furnaceSequenceCounter;
    float monsterSequenceCounter;
    float tugOfWarCounter;
    // endregion

    // region States
    bool transportState;
    bool monsterTransportState;

    int currentFurnacePhase = IDLE_PHASE;
    int currentMonsterPhase = IDLE_PHASE;
    int currentTugOfWarPhase = -1;
    // endregion

    // endregion

    // endregion
    
    // region Runtime
    
    bool onInit() {

        coaster = sim.getCoasterForEntityId(getParentEntityId());

        loadingStation = coaster.getSection("mf_sec_loading_station");

        mineEntranceTransport = coaster.getSection("mf_sec_mineEntrance_transport");

        furnaceBlock = coaster.getSection("mf_sec_furnace_block");
        furnaceTransfer = coaster.getSpecialTrack("mf_spec_furnace_transfer");
        furnaceApproach = coaster.getSection("mf_sec_furnaceApproach_transport");

        monsterApproachBlock = coaster.getSection("mf_sec_monsterApproach_block");
        monsterBlock = coaster.getSection("mf_sec_monster_block");
        monsterTransfer = coaster.getSpecialTrack("mf_spec_monster_transfer");
        liftLaunch = coaster.getSection("mf_sec_liftLaunch_transport");

        System.out.println("Mineral Forge initialized.");

        return true;
    }

    void onNextFrame(float tick) {

        basicCounter += tick;

        if (basicCounter >=1) {
            showStats();
            basicCounter -= 1;
        }

        dispatch();

        mineEntranceSequence(tick);
        furnaceSequence(tick);
        monsterSequence(tick);
        
    }

    // endregion

    // region Helper Methods
    
    public void resetTransferTable(SpecialTrack transferTable, int defaultPosition) {

        int currentPosition = transferTable.getSwitchDirection();

        if (currentPosition == -1) {

            return;

        }
        else if (currentPosition != defaultPosition && transferTable.canChangeSwitchDirection()) {

            transferTable.setSwitchDirection(defaultPosition);

        }

    }

    public void dispatch() {

        if (loadingStation.isStationWaitingForClearBlock()) {

            if (!furnaceBlock.isTrainOnSection()) {
                loadingStation.setStationNextBlockClear();
            }

        }

        if (loadingStation.isStationWaitingForAdvance()) {

            loadingStation.setStationLeaving();

            loadingStation.setBrakesOff();

            loadingStation.setTransportsStandardFwdOn();

        }

    }

    public void showStats() {

        System.out.println("Furnace Sequence Counter: " + furnaceSequenceCounter);
        System.out.println("Current Furnace Phase: " + currentFurnacePhase);
        System.out.println("Current Monster Phase: " + currentMonsterPhase);
        System.out.println("Tug of War Counter: " + tugOfWarCounter);
        System.out.println("Current Tug of War Phase: " + currentTugOfWarPhase);
        
    }

    public void transportStutter(Section section, float onDuration, float offDuration) {

        if (transportState && mineEntranceCounter >= onDuration) {

            section.setTransportsOff();
            mineEntranceCounter = 0;
            transportState = false;

        }
        else if (!transportState && mineEntranceCounter >= offDuration) {

            section.setTransportsStandardFwdOn();
            mineEntranceCounter = 0;
            transportState = true;

        }
    }

    public void tugOfWar(float tick, Section section) {

        final int PRE_SHIFT = -1;
        final int SHIFT_1 = 0;
        final int SHIFT_2 = 1;
        final int SHIFT_3 = 2;
        final int SHIFT_4 = 3;
        final int SHIFT_5 = 4;

        tugOfWarCounter += tick;

        if (currentTugOfWarPhase == PRE_SHIFT) {

            section.setBrakesOff();
            currentTugOfWarPhase = SHIFT_1;

        }

        else if (currentTugOfWarPhase == SHIFT_1) {

            if (monsterTransportState && tugOfWarCounter >= 1.0f) {

            section.setTransportsOff();
            section.setBrakesOn();
            tugOfWarCounter = 0;
            monsterTransportState = false;
            currentTugOfWarPhase = SHIFT_2;

            }
            else if (!monsterTransportState && tugOfWarCounter >= 1.0f) {

                section.setTransportsStandardFwdOn();
                tugOfWarCounter = 0;
                monsterTransportState = true;

            }

        }

        else if (currentTugOfWarPhase == SHIFT_2) {

            if (monsterTransportState && tugOfWarCounter >= 0.5f) {

            section.setTransportsOff();
            section.setBrakesOn();
            tugOfWarCounter = 0;
            monsterTransportState = false;
            currentTugOfWarPhase = SHIFT_3;

            }
            else if (!monsterTransportState && tugOfWarCounter >= 0.5f) {

                section.setBrakesOff();
                section.setTransportsLaunchBwdOn();
                tugOfWarCounter = 0;
                monsterTransportState = true;

            }

        }

        else if (currentTugOfWarPhase == SHIFT_3) {

            if (monsterTransportState && tugOfWarCounter >= 0.5f) {

            section.setTransportsOff();
            section.setBrakesOn();
            tugOfWarCounter = 0;
            monsterTransportState = false;
            currentTugOfWarPhase = SHIFT_4;

            }
            else if (!monsterTransportState && tugOfWarCounter >= 0.5f) {

                section.setBrakesOff();
                section.setTransportsLaunchFwdOn();
                tugOfWarCounter = 0;
                monsterTransportState = true;

            }

        }

        else if (currentTugOfWarPhase == SHIFT_4) {

            if (monsterTransportState && tugOfWarCounter >= 0.75f) {

            section.setTransportsOff();
            section.setBrakesOn();
            tugOfWarCounter = 0;
            monsterTransportState = false;
            currentTugOfWarPhase = SHIFT_5;

            }
            else if (!monsterTransportState && tugOfWarCounter >= 0.3f) {

                section.setBrakesOff();
                section.setTransportsLaunchBwdOn();
                tugOfWarCounter = 0;
                monsterTransportState = true;

            }

        }

        else if (currentTugOfWarPhase == SHIFT_5) {

            section.setBrakesOff();
            section.setTransportsLaunchFwdOn();

            if (!section.isTrainOnSection()) {

                currentTugOfWarPhase = PRE_SHIFT;
                
            }

        }
        
    }

    // endregion

    // region Sequence Methods

    public void mineEntranceSequence(float tick) {


        if (!mineEntranceTransport.isTrainOnSection()) {

            mineEntranceTransport.setTransportsOff();
            transportState = false;

        }
        else {
            
            mineEntranceCounter += tick;
            transportStutter(mineEntranceTransport, 4.0f, 0.3f);

        }
    }

    public void furnaceSequence(float tick) {

        final float PRE_SHIFT_WAIT_TIME = 8.0f;
        final float POST_SHIFT_WAIT_TIME = 4.0f;

        if (currentFurnacePhase == IDLE_PHASE || currentFurnacePhase == APPROACH_PHASE) {

            if (furnaceApproach.isTrainOnSection()) {

                furnaceApproach.setTransportsStandardFwdOn();
                currentFurnacePhase = APPROACH_PHASE;

            }
            else {

                furnaceApproach.setTransportsOff();

            }

        }

        if (currentFurnacePhase == APPROACH_PHASE) {

            furnaceBlock.setBrakesOff();
            furnaceBlock.setTransportsStandardFwdOn();

            if (furnaceBlock.isTrainBehindEndOfSection(2.0)) {

                furnaceBlock.setTransportsOff();
                furnaceBlock.setBrakesOn();

                currentFurnacePhase = PRE_SHIFT_PHASE;
            }

        }

        else if (currentFurnacePhase == PRE_SHIFT_PHASE) {

            furnaceSequenceCounter += tick;

            if (furnaceSequenceCounter >= PRE_SHIFT_WAIT_TIME) {

                furnaceTransfer.setSwitchDirection(1);
                furnaceSequenceCounter = 0;
                currentFurnacePhase = SHIFT_PHASE;

            }

        }

        else if (currentFurnacePhase == SHIFT_PHASE) {

            if(furnaceTransfer.getSwitchDirection() == 1) {

                currentFurnacePhase = POST_SHIFT_PHASE;

            }

        }

        else if (currentFurnacePhase == POST_SHIFT_PHASE) {

            furnaceSequenceCounter += tick;

            if (furnaceSequenceCounter >= POST_SHIFT_WAIT_TIME) {

                currentFurnacePhase = LAUNCHING_PHASE;

            }

        }

        else if (currentFurnacePhase == LAUNCHING_PHASE) {

            furnaceBlock.setBrakesOff();
            furnaceBlock.setTransportsLaunchBwdOn();
            furnaceSequenceCounter = 0;

            if (!furnaceBlock.isTrainOnSection()) {

                currentFurnacePhase = RESET_PHASE;

            }

        }

        else if (currentFurnacePhase == RESET_PHASE) {

            furnaceBlock.setTransportsOff();
            furnaceBlock.setBrakesOn();

            resetTransferTable(furnaceTransfer, DEFAULT_FURNACE_TRANSFER_POSITION);

            if (furnaceTransfer.getSwitchDirection() == 0) {

                currentFurnacePhase = IDLE_PHASE;

            }
        }
    }

    public void monsterSequence(float tick) {

        final float PRE_SHIFT_WAIT_TIME = 2.0f;
        final float POST_SHIFT_WAIT_TIME = 4.0f;

        if (currentMonsterPhase == IDLE_PHASE || currentMonsterPhase == APPROACH_PHASE) {

            if (monsterApproachBlock.isTrainOnSection()) {

                monsterApproachBlock.setTransportsStandardBwdOn();
                currentMonsterPhase = APPROACH_PHASE;

            }
            else {

                monsterApproachBlock.setTransportsOff();

            }

        }

        if (currentMonsterPhase == APPROACH_PHASE) {

            monsterBlock.setBrakesOff();
            monsterBlock.setTransportsStandardBwdOn();

            if (monsterBlock.isTrainBeforeStartOfSection(8.0)) {

                monsterBlock.setTransportsOff();
                monsterBlock.setBrakesOn();

                currentMonsterPhase = PRE_SHIFT_PHASE;
            }

        }

        else if (currentMonsterPhase == PRE_SHIFT_PHASE) {

            monsterSequenceCounter += tick;

            if (monsterSequenceCounter >= PRE_SHIFT_WAIT_TIME) {

                monsterTransfer.setSwitchDirection(1);
                monsterSequenceCounter = 0;
                currentMonsterPhase = SHIFT_PHASE;

            }

        }

        else if (currentMonsterPhase == SHIFT_PHASE) {

            if(monsterTransfer.getSwitchDirection() == 1) {

                currentMonsterPhase = POST_SHIFT_PHASE;

            }

        }

        else if (currentMonsterPhase == POST_SHIFT_PHASE) {

            monsterSequenceCounter += tick;

            if (monsterSequenceCounter >= POST_SHIFT_WAIT_TIME) {

                currentMonsterPhase = LAUNCHING_PHASE;

            }

        }

        else if (currentMonsterPhase == LAUNCHING_PHASE) {

            tugOfWar(tick, monsterBlock);

            monsterSequenceCounter = 0;

            if (!monsterBlock.isTrainOnSection()) {

                currentMonsterPhase = RESET_PHASE;

            }

        }

        else if (currentMonsterPhase == RESET_PHASE) {

            monsterBlock.setTransportsOff();
            monsterBlock.setBrakesOn();

            resetTransferTable(monsterTransfer, DEFAULT_MONSTER_TRANSFER_POSITION);

            if (monsterTransfer.getSwitchDirection() == 0) {

                currentMonsterPhase = IDLE_PHASE;

            }
        }

    }

    // endregion

}
